generator client {
    provider        = "prisma-client"
    previewFeatures = ["strictUndefinedChecks"]
    output          = "../shared/generated/"
    engineType      = "client"
}

generator kysely {
    provider = "prisma-kysely"

    output   = "../shared/generated/"
    fileName = "kysely.ts"
}

datasource db {
    provider = "postgresql"
}

model User {
    id String @id @default(cuid(2))

    givenName  String @default("") // first name
    familyName String @default("") // last name

    emailAddress String @unique
    password     String

    emailVerified                 Boolean   @default(false)
    emailVerifiedAt               DateTime?
    emailVerificationToken        String?   @unique
    emailVerificationTokenExpires DateTime?

    created DateTime @default(now())
    updated DateTime @updatedAt

    things Thing[]

    @@index([emailAddress])
}

model Thing {
    id String @id @default(cuid(2))

    name String

    userId String
    user   User   @relation(fields: [userId], references: [id])

    created DateTime @default(now())
    updated DateTime @updatedAt
}

model Conference {
    id String @id @default(cuid(2))

    sourceUrl String @unique

    collectionDate DateTime @db.Date
    sources        String[] // maps from `_sources` in the scraped JSON

    conferenceName       String
    conferenceYear       Int?
    conferenceUri        String?
    conferenceLocation   String?
    conferenceStartDate  DateTime? @db.Date
    conferenceEndDate    DateTime? @db.Date
    conferenceAcronym    String?
    conferenceSeries     String?
    conferenceCategories String[]  @default([])
    conferenceText       String?   @db.Text
    submissionDeadline   DateTime? @db.Date

    created DateTime @default(now())
    updated DateTime @updatedAt

    @@index([conferenceYear])
    @@index([conferenceStartDate])
    @@index([submissionDeadline])
}
