generator client {
    provider        = "prisma-client"
    previewFeatures = ["strictUndefinedChecks"]
    output          = "../shared/generated/"
    engineType      = "client"
}

generator kysely {
    provider = "prisma-kysely"

    output   = "../shared/generated/"
    fileName = "kysely.ts"
}

datasource db {
    provider = "postgresql"
}

model User {
    id String @id @default(cuid(2))

    givenName  String @default("") // first name
    familyName String @default("") // last name

    emailAddress String @unique
    password     String

    emailVerified                 Boolean   @default(false)
    emailVerifiedAt               DateTime?
    emailVerificationToken        String?   @unique
    emailVerificationTokenExpires DateTime?

    created DateTime @default(now())
    updated DateTime @updatedAt

    things Thing[]

    @@index([emailAddress])
}

model Thing {
    id String @id @default(cuid(2))

    name String

    userId String
    user   User   @relation(fields: [userId], references: [id])

    created DateTime @default(now())
    updated DateTime @updatedAt
}

model Conference {
    /// CollectedConference.id
    id String @id

    conferenceName   String
    conferenceYear   Int?
    conferenceLocation String?
    conferenceUri    String?

    conferenceIdentifier     String?
    conferenceIdentifierType String?
    conferenceSchemaUri      String?

    conferenceStartDate DateTime? @db.Date
    conferenceEndDate   DateTime? @db.Date
    conferenceAcronym   String?
    conferenceSeries    String?

    /// CollectedConference._sources
    sources String[] @default([])

    collectionDate DateTime? @db.Date

    conferenceCategories String[] @default([])
    conferenceText       String?   @db.Text
    submissionDeadline   DateTime? @db.Date

    created DateTime @default(now())
    updated DateTime @updatedAt

    @@index([conferenceYear])
    @@index([conferenceStartDate])
    @@index([submissionDeadline])
}
